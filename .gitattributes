# Normalize line endings for a repo that is used on Windows, macOS and Linux.
* text=auto

# Shell scripts must keep LF so they run on macOS/Linux after checkout.
*.sh   text eol=lf

# Windows-native scripts keep CRLF.
*.bat  text eol=crlf
*.cmd  text eol=crlf
*.ps1  text eol=crlf

# Sources and docs: LF everywhere.
*.py   text eol=lf
*.md   text eol=lf
*.yaml text eol=lf
*.yml  text eol=lf
*.txt  text eol=lf
*.html text eol=lf
*.css  text eol=lf
*.js   text eol=lf

# Binary assets should never be touched.
*.png binary
*.jpg binary
*.ico binary
