# Copy to .env, or just export these variables in your shell.
# Note: a .env file is not required for normal use — you can enter a key in the
# Web UI and click "Save locally" (it is written to secrets.local.json, loaded
# automatically after restarts, and git-ignored). The environment variables
# below are an optional alternative.

# --- Gateway runtime settings ---
GATEWAY_HOST=127.0.0.1
GATEWAY_PORT=8787

# Optional: when set, every /api/admin/* request must carry this token.
# GATEWAY_ADMIN_TOKEN=change-me

# Optional: config file path (default: ./config.yaml)
# GATEWAY_CONFIG=config.yaml

# Optional: local key file path (default: secrets.local.json next to config.yaml)
# GATEWAY_SECRETS=secrets.local.json

# --- Provider API keys (optional; saving in the UI is easier) ---
# OPENAI_API_KEY=sk-...
# DEEPSEEK_API_KEY=sk-...
# ANTHROPIC_API_KEY=sk-ant-...
# MY_PROXY_API_KEY=...
