# 复制为 .env，或直接在当前 shell 里导出这些变量。
# 注意：普通使用不需要 .env —— 你可以在 Web 界面里把 Key「保存到本地」
# （写入 secrets.local.json，重启后自动加载，已加入 .gitignore）。
# 下面的环境变量方式是可选的替代方案。

# --- 网关运行参数 ---
GATEWAY_HOST=127.0.0.1
GATEWAY_PORT=8787

# 可选：设置后，所有 /api/admin/* 请求都必须携带该 Token。
# GATEWAY_ADMIN_TOKEN=change-me

# 可选：配置文件路径（默认为 ./config.yaml）
# GATEWAY_CONFIG=config.yaml

# 可选：本地密钥文件路径（默认为 config.yaml 同目录下的 secrets.local.json）
# GATEWAY_SECRETS=secrets.local.json

# --- 服务商 API Key（可选，界面里保存更省事）---
# OPENAI_API_KEY=sk-...
# DEEPSEEK_API_KEY=sk-...
# ANTHROPIC_API_KEY=sk-ant-...
# MY_PROXY_API_KEY=...
